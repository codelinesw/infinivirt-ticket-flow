// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum RoleName {
  ADMIN
  SUPPORT_AGENT
  SUPERVISOR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ------------------------------------------------------
// TABLAS / MODELOS
// ------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  roleId       String   @map("role_id") @db.VarChar(36)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Relaciones con tickets
  createdTickets      Ticket[]           @relation("TicketCreatedBy")
  assignedTickets     Ticket[]           @relation("TicketAssignedTo")
  comments            TicketComment[]
  statusChanges       TicketStatusHistory[]
  assignmentsMade     TicketAssignment[] @relation("AssignedBy")
  assignmentsReceived TicketAssignment[] @relation("AssignedTo")

  @@map("users")
}

model Client {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  domain    String?  @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("clients")
}

model Ticket {
  id             String         @id @default(uuid()) @db.VarChar(36)
  ticket_number  Int            @db.Int
  clientId       String         @map("client_id") @db.VarChar(36)
  createdBy      String         @map("created_by") @db.VarChar(36)
  assignedTo     String?        @map("assigned_to") @db.VarChar(36)
  title          String         @db.VarChar(200)
  description    String         @db.Text
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  lastActivityAt DateTime       @default(now()) @map("last_activity_at")
  dueAt          DateTime?      @map("due_at")
  resolvedAt     DateTime?      @map("resolved_at")
  closedAt       DateTime?      @map("closed_at")

  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creator  User   @relation("TicketCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  assignee User?  @relation("TicketAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)

  comments      TicketComment[]
  assignments   TicketAssignment[]
  statusHistory TicketStatusHistory[]

  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([clientId])
  @@index([lastActivityAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.VarChar(36)
  ticketId   String   @map("ticket_id") @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  comment    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketAssignment {
  id           String    @id @default(uuid()) @db.VarChar(36)
  ticketId     String    @map("ticket_id") @db.VarChar(36)
  assignedTo   String    @map("assigned_to") @db.VarChar(36)
  assignedBy   String    @map("assigned_by") @db.VarChar(36)
  notes      String       @db.VarChar(520)
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee User   @relation("AssignedTo", fields: [assignedTo], references: [id], onDelete: Restrict)
  assigner User   @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_assignments")
}

model TicketStatusHistory {
  id         String       @id @default(uuid()) @db.VarChar(36)
  ticketId   String       @map("ticket_id") @db.VarChar(36)
  fromStatus TicketStatus @map("from_status")
  toStatus   TicketStatus @map("to_status")
  notes      String       @db.VarChar(520)
  changedBy  String       @map("changed_by") @db.VarChar(36)
  changedAt  DateTime     @default(now()) @map("changed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_status_history")
}
